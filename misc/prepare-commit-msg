#!/usr/bin/env bash

mapfile -t macros < <(git diff-index --cached --name-only 'HEAD^{tree}' | awk -F/ '{print $NF}' | uniq | sed -e "s|.ass$||g" -e "s|.md$||g" -e "s|.py$||g" -e 's/^./\U&/g' -e 's/ ./\U&/g' | awk '!a[$0]++')

if ((${#macros[@]})) && ! head -1 "$1" | grep -q -e '^\[' -e '^fixup!' -e '^squash!'; then
    sed -i '1s/^/['"$(
        IFS=,
        printf "%s" "${macros[*]}"
    )"'] /' "$1"
fi
